# BLUE NINE — Backend environment variables (copy to .env, never commit)

# 실행 환경: development | production
BLUE_NINE_ENV=development

# Render/Heroku 류는 PORT 를 자동 주입. 로컬에선 8088 고정.
PORT=8088
HOST=127.0.0.1
RELOAD=true

# CORS 화이트리스트. 콤마 구분. "*" 또는 빈 값이면 모든 origin 허용.
# 예) https://blue-nine.vercel.app,https://blue-nine-frontend-yourname.vercel.app
BLUE_NINE_ALLOWED_ORIGINS=*

# 마스터 데이터(제작단가기준집.pdf) 경로 override (Source 36)
# BLUE_NINE_REF_DIR=/opt/render/project/src/reference
# BLUE_NINE_MASTER_PDF=제작단가기준집.pdf
