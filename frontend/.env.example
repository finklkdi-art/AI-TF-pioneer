# BLUE NINE — Frontend environment variables (Vite)
# .env.example 를 복사:
#   - 로컬:        cp .env.example .env.local
#   - Vercel UI:   Project Settings → Environment Variables 에 추가

# 백엔드 API base URL.
#  - 로컬 개발: 빈 문자열 (vite.config.js 의 /api 프록시 사용)
#  - 프로덕션:  Render 백엔드 URL (예: https://blue-nine-api.onrender.com)
VITE_API_BASE=
