# ─────────────────────────────────────────────────────────────
# BLUE NINE — Root .env template
#
# 사용법:
#   1) 로컬:     cp .env.example .env  →  실제 키 입력
#   2) Render:   Dashboard → blue-nine-api → Environment 탭에 같은 키/값 추가
#   3) Vercel:   Settings → Environment Variables (단, *_API_KEY 는 서버 측 키이므로 절대 프론트에 두지 말 것)
# ─────────────────────────────────────────────────────────────

# ── BLUE NINE 운영 설정
BLUE_NINE_ENV=development                 # development | production
PORT=8088                                 # Render는 자동 주입, 로컬 기본값
HOST=127.0.0.1
RELOAD=true
BLUE_NINE_ALLOWED_ORIGINS=*               # 콤마 구분 화이트리스트 권장 (Vercel 도메인 확정 후)

# 마스터 데이터 경로 (Source 16, 36) — 기본값 = repo_root/reference
# BLUE_NINE_REF_DIR=
# BLUE_NINE_MASTER_PDF=제작단가기준집.pdf

# ── LLM 키 (스캐폴딩 — 미사용시 비워둬도 휴리스틱 파서가 그대로 동작)
# LlamaParse: PDF/Excel 고정밀 추출 (향후 Precise 모드 연동 예정)
#   발급: https://cloud.llamaindex.ai/api-key
LLAMAPARSE_API_KEY=

# Anthropic Claude: 라인아이템 분류/정제 (향후 Precise 모드 연동 예정)
#   발급: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6        # (선택) 사용할 모델 ID 명시

# ── Admin 콘솔 키 (마스터 데이터 reload — Source 36)
BLUE_NINE_ADMIN_KEY=BLUE_NINE_ADMIN
